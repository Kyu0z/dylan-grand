// Dylan Grand Hotel — single-property booking and operations schema.
// Date-only business fields are PostgreSQL DATE; check-out is exclusive.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RECEPTIONIST
  HOUSEKEEPING
  MANAGER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum RatePlan {
  FLEXIBLE
  NON_REFUNDABLE
}

enum CleaningStatus {
  DIRTY
  CLEAN
  INSPECTED
}

enum TransactionKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum ServiceOrderStatus {
  REQUESTED
  FULFILLED
  CANCELLED
}

model HotelSettings {
  id            String   @id @default("dylan-grand-hotel")
  nameEn        String   @default("Dylan Grand Hotel") @db.VarChar(120)
  nameVi        String   @default("Khách sạn Dylan Grand") @db.VarChar(120)
  email         String?  @db.VarChar(180)
  phone         String?  @db.VarChar(32)
  address       String?  @db.VarChar(300)
  descriptionEn String?  @db.VarChar(2000)
  descriptionVi String?  @db.VarChar(2000)
  checkInTime   String   @default("14:00") @db.VarChar(5)
  checkOutTime  String   @default("12:00") @db.VarChar(5)
  updatedAt     DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(180)
  passwordHash String    @db.VarChar(240)
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true)
  fullName     String?   @db.VarChar(120)
  pendingActivation Boolean @default(false)
  staffSessionVersion Int @default(0)
  bookings     Booking[]
  guestProfile Guest?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Guest {
  id                String    @id @default(cuid())
  name              String    @db.VarChar(120)
  email             String    @db.VarChar(180)
  phone             String?   @db.VarChar(32)
  notes             String?   @db.VarChar(1000)
  preferences       String?   @db.VarChar(1000)
  favoriteRoomCodes String[]  @default([])
  accountId         String?   @unique
  account           User?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  bookings          Booking[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@index([email])
}

model RoomType {
  id            String         @id @default(cuid())
  code          String         @unique @db.VarChar(40)
  nameEn        String         @db.VarChar(100)
  nameVi        String         @db.VarChar(100)
  descriptionEn String?        @db.VarChar(2000)
  descriptionVi String?        @db.VarChar(2000)
  sizeSqm       Int?
  bedsEn        String?        @db.VarChar(100)
  bedsVi        String?        @db.VarChar(100)
  viewEn        String?        @db.VarChar(100)
  viewVi        String?        @db.VarChar(100)
  amenities     String[]       @default([])
  imageUrls     String[]       @default([])
  maxGuests     Int
  baseRateVnd   Int            @default(0)
  isPublished   Boolean        @default(false)
  physicalRooms PhysicalRoom[]
  bookings      Booking[]
  dailyRates    DailyRate[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PhysicalRoom {
  id             String             @id @default(cuid())
  number         String             @unique @db.VarChar(20)
  floor          Int
  roomTypeId     String
  roomType       RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  sellable       Boolean            @default(true)
  cleaningStatus CleaningStatus     @default(DIRTY)
  bookings       Booking[]
  blocks         MaintenanceBlock[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  @@index([roomTypeId])
}

model DailyRate {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  date       DateTime @db.Date
  amountVnd  Int
  @@unique([roomTypeId, date])
}

model MaintenanceBlock {
  id        String       @id @default(cuid())
  roomId    String
  room      PhysicalRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  reason    String       @db.VarChar(300)
  createdAt DateTime     @default(now())
  @@index([roomId, startDate, endDate])
}

model Booking {
  id               String          @id @default(cuid())
  code             String          @unique @db.VarChar(40)
  clientRequestId  String          @unique @db.VarChar(100)
  payloadHash      String          @db.VarChar(64)
  lookupTokenHash  String          @db.VarChar(64)
  customerId       String?
  customer         User?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestId          String
  guest            Guest           @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomTypeId       String
  roomType         RoomType        @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  roomId           String
  room             PhysicalRoom    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkIn          DateTime        @db.Date
  checkOut         DateTime        @db.Date
  adults           Int
  children         Int             @default(0)
  specialRequests  String?         @db.VarChar(500)
  ratePlan         RatePlan        @default(FLEXIBLE)
  status           BookingStatus   @default(CONFIRMED)
  holdExpiresAt    DateTime?
  expectedArrivalAt DateTime?
  roomTotalVnd     Int
  discountVnd      Int             @default(0)
  extraTotalVnd    Int             @default(0)
  totalVnd         Int
  cancelFeeVnd     Int             @default(0)
  promoCode        String?         @db.VarChar(32)
  rateSnapshot     Json
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  payments         PaymentTransaction[]
  adjustments      FolioAdjustment[]
  services         ServiceOrder[]
  review           Review?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@index([roomId, checkIn, checkOut, status])
  @@index([roomTypeId, checkIn, checkOut])
  @@index([customerId])
}

model FolioAdjustment {
  idempotencyKey String?  @unique @db.VarChar(100)
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amountVnd      Int
  reason         String   @db.VarChar(300)
  actorId        String   @db.VarChar(50)
  createdAt      DateTime @default(now())
  @@index([bookingId])
}

model PaymentTransaction {
  id             String          @id @default(cuid())
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  kind           TransactionKind
  method         PaymentMethod
  amountVnd      Int
  idempotencyKey String          @unique @db.VarChar(100)
  reference      String?         @db.VarChar(120)
  note           String?         @db.VarChar(300)
  actorId        String?         @db.VarChar(50)
  createdAt      DateTime        @default(now())
  @@index([bookingId, createdAt])
}

model ExtraService {
  id        String         @id @default(cuid())
  code      String         @unique @db.VarChar(40)
  name      String         @db.VarChar(120)
  unit      String         @db.VarChar(40)
  priceVnd  Int
  isActive  Boolean        @default(true)
  orders    ServiceOrder[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ServiceOrder {
  id              String             @id @default(cuid())
  bookingId       String
  clientRequestId String             @unique @db.VarChar(100)
  booking         Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  serviceId       String
  service         ExtraService       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  status          ServiceOrderStatus @default(REQUESTED)
  quantity        Int
  unitPriceVnd    Int
  totalVnd        Int
  scheduledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@index([bookingId])
}

model Promotion {
  id              String   @id @default(cuid())
  code            String   @unique @db.VarChar(32)
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  usageLimit      Int
  usageCount      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id         String    @id @default(cuid())
  bookingId  String    @unique
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  stars      Int
  comment    String    @db.VarChar(2000)
  response   String?   @db.VarChar(2000)
  isVisible  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.VarChar(50)
  operation  String   @db.VarChar(100)
  entity     String   @db.VarChar(80)
  entityId   String   @db.VarChar(80)
  detail     Json?
  createdAt  DateTime @default(now())
  @@index([entity, entityId, createdAt])
}

model ContactInquiry {
  id         String    @id @default(cuid())
  name       String    @db.VarChar(120)
  email      String    @db.VarChar(180)
  topic      String    @db.VarChar(60)
  message    String    @db.VarChar(2000)
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  @@index([resolved, createdAt])
}
