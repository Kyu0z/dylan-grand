# Development environment only. NEVER commit actual credentials.
NODE_ENV=development
PORT=4000
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Pooled DATABASE_URL and direct DIRECT_URL must point to the same Neon branch.
DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-EXAMPLE.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Generate strong independent secrets. Min lengths: JWT 32 chars, bootstrap key 16 chars.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_MIN_32_CHARACTERS
BOOTSTRAP_KEY=REPLACE_WITH_RANDOM_MIN_16_CHARACTERS

# Fixed policy defaults implemented in this development version:
# HOTEL_TZ=Asia/Ho_Chi_Minh, CHECKIN=14:00, CHECKOUT=12:00
# HOLD_MINUTES=15, MAX_STAY_NIGHTS=30, FLEXIBLE_CANCEL_CUTOFF_HOURS=48
# NON_REFUNDABLE_DISCOUNT_PERCENT=10, MAX_PROMOTION_DISCOUNT_PERCENT=30
# PAYMENTS: cash or bank transfer manually recorded by authorized staff; NO payment provider.
